<%= render Ui::ShellComponent.new(
  title: "Dashboard",
  subtitle: "Release Safety Decision Cockpit",
  eyebrow: "CELLGUARD MISSION CONTROL"
) do %>

  <div class="space-y-4" data-gsap="dashboard">
    <%# A. Sticky Command Bar %>
    <%= render Ui::CommandBarComponent.new(
      shard: @shard.name,
      gate_open: @budget.release_gate_open,
      burn_rate: @budget.current_burn_rate.to_f,
      budget_remaining: @budget.budget_remaining.to_f,
      last_eval_at: @budget.evaluated_at
    ) %>

    <%# B. 30-Second Demo Flow %>
    <%= render Ui::DemoFlowComponent.new %>

    <%# C. Release Gate Hero Panel %>
    <%= render Ui::GatePanelComponent.new(
      gate_open: @budget.release_gate_open,
      reason: (@budget.release_gate_open ? nil : "Error budget exhausted. Override requires justification + audit log."),
      violation_started_at: @budget.violation_started_at,
      burn_rate: @budget.current_burn_rate.to_f,
      budget_remaining: @budget.budget_remaining.to_f,
      active_incident: @incidents.any? { |i| i.status.to_s.downcase != "resolved" },
      last_eval_at: @budget.evaluated_at,
      recommended_action: (@budget.release_gate_open ? nil : "Review runbook before override")
    ) %>

    <%# D. Decision Timeline — full-width horizontal %>
    <%= render Ui::DecisionTimelineComponent.new %>

    <%# E. Lower Dashboard — Dense Grid %>

    <%# Row 1: SRE Scorecards %>
    <div class="grid gap-3 md:grid-cols-3" data-gsap="scorecards">
      <article class="cg-scorecard">
        <div class="cg-scorecard__label">Chaos Drill Success (30d)</div>
        <div class="cg-scorecard__value"><%= @sre_scorecards.dig(:chaos, :success_rate_label) %></div>
        <div class="cg-scorecard__meta">
          <%= @sre_scorecards.dig(:chaos, :successful) %> /
          <%= @sre_scorecards.dig(:chaos, :executed) %> executed
          • <%= @sre_scorecards.dig(:chaos, :skipped) %> skipped
        </div>
      </article>

      <article class="cg-scorecard">
        <div class="cg-scorecard__label">MTTR (30d)</div>
        <div class="cg-scorecard__value"><%= @sre_scorecards.dig(:mttr, :label) %></div>
        <div class="cg-scorecard__meta">
          <%= @sre_scorecards.dig(:mttr, :resolved_count) %> resolved
        </div>
      </article>

      <article class="cg-scorecard">
        <div class="cg-scorecard__label">Gate Locks (7d)</div>
        <div class="cg-scorecard__value"><%= @sre_scorecards.dig(:gate_locks, :recent_total) %></div>
        <div class="cg-scorecard__meta"><%= @sre_scorecards.dig(:gate_locks, :trend_label) %></div>
        <div class="cg-scorecard__sparkline"><%= @sre_scorecards.dig(:gate_locks, :sparkline) %></div>
      </article>
    </div>

    <%# Row 2: Autonomous Agents — Full width for density %>
    <div class="cg-panel" data-gsap="agent-activity">
      <div class="cg-panel-header">
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
          <div class="cg-panel-title" style="margin:0;">Autonomous Agents</div>
        </div>
      </div>
      <div class="p-3">
        <%= render Ui::AgentActivityComponent.new(
          agents: @agent_status,
          recent_activity: @agent_activity
        ) %>
      </div>
    </div>

    <%# Row 3: Error Budget + Chaos Engineering %>
    <div class="grid gap-3 md:grid-cols-2 items-stretch">
      <%# Error Budget %>
      <div class="cg-panel flex flex-col" data-gsap="budget-panel">
        <div class="cg-panel-header">
          <div class="cg-panel-title">Error Budget</div>
        </div>
        <div class="p-4 flex-1 flex flex-col justify-center">
          <%= render Ui::BudgetMeterComponent.new(remaining: @budget.budget_remaining.to_f) %>
          <div class="mt-4 grid grid-cols-2 gap-4 text-xs">
            <div>
              <div style="color: var(--cg-muted-dim); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600;">SLO Target</div>
              <div class="font-mono mt-1" style="color: var(--cg-text);"><%= (@budget.slo_target.to_f * 100).round(1) %>%</div>
            </div>
            <div>
              <div style="color: var(--cg-muted-dim); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600;">Window</div>
              <div class="font-mono mt-1" style="color: var(--cg-text);"><%= @budget.window_days %>d</div>
            </div>
            <div>
              <div style="color: var(--cg-muted-dim); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600;">Consumed</div>
              <div class="font-mono mt-1" style="color: var(--cg-text);"><%= (@budget.budget_consumed.to_f * 100).round(2) %>%</div>
            </div>
            <div>
              <div style="color: var(--cg-muted-dim); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600;">Burn Rate</div>
              <div class="font-mono mt-1" style="color: var(--cg-text);"><%= @budget.current_burn_rate.to_f %>x</div>
            </div>
          </div>
        </div>
      </div>

      <%# Chaos Engineering — Preserved existing chaos buttons %>
      <div class="cg-panel flex flex-col" id="game-day" data-gsap="chaos-panel">
        <div class="cg-panel-header">
          <div class="cg-panel-title">Chaos Engineering</div>
        </div>
        <div class="p-3 flex-1">
          <%= render Ui::ChaosGamedayComponent.new(
            shard: @shard.name,
            default_duration: 20,
            chaos_insight: @chaos_insight
          ) %>
        </div>
      </div>
    </div>

    <%# Row 4: Recent Incidents + Audit Trail %>
    <div class="grid gap-3 md:grid-cols-2">
      <div class="cg-panel" data-gsap="incidents-panel">
        <div class="cg-panel-header">
          <div>
            <div class="cg-panel-title">Recent Incidents</div>
            <div class="cg-panel-subtitle">
              <% if @incident_scope == :global %>Global feed<% else %>Shard scope<% end %>
            </div>
          </div>
          <a href="/incidents" class="cg-btn cg-btn--sm cg-btn--secondary">View All</a>
        </div>
        <div class="p-3 space-y-2">
          <% @incidents.first(5).each do |i| %>
            <div class="cg-evidence" style="padding: 0.6rem 0.75rem; background: rgba(0,0,0,0.25);">
              <div class="flex items-center justify-between gap-2">
                <div class="text-sm font-medium truncate" style="color: var(--cg-text-bright);"><%= i.title %></div>
                <span class="cg-severity cg-severity--<%= i.severity_label.to_s.downcase %>"><%= i.severity_label %></span>
              </div>
              <div class="mt-1 text-xs" style="color: var(--cg-text);">
                <%= i.status %> • <%= time_ago_in_words(i.created_at) %> ago
                <% if i.shard&.name.present? %>
                  • <span class="font-mono" style="color: var(--cg-text-bright);"><%= i.shard.name %></span>
                <% end %>
              </div>
              <% if i.context&.dig("suggested_runbooks").present? %>
                <div class="mt-1.5 flex flex-wrap gap-1">
                  <% i.context["suggested_runbooks"].first(2).each do |rb| %>
                    <a href="/runbooks/<%= rb['slug'] %>?incident_id=<%= i.id %>" class="cg-chip--runbook" style="font-size: 0.62rem; padding: 0.1rem 0.35rem;">
                      <%= rb['title'] %>
                    </a>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="cg-panel" data-gsap="audit-panel">
        <div class="cg-panel-header">
          <div>
            <div class="cg-panel-title">Audit Trail</div>
            <div class="cg-panel-subtitle">
              <% if @audit_scope == :global %>Global feed<% else %>Shard scope<% end %>
            </div>
          </div>
        </div>
        <div class="p-3 space-y-2">
          <% @audit_logs.first(5).each do |a| %>
            <div class="cg-evidence" style="padding: 0.6rem 0.75rem; background: rgba(0,0,0,0.25);">
              <div class="flex items-center justify-between gap-2">
                <div class="text-sm font-medium" style="color: var(--cg-text-bright);"><%= a.action %></div>
                <div class="text-xs font-mono" style="color: var(--cg-muted);"><%= time_ago_in_words(a.created_at) %></div>
              </div>
              <div class="mt-0.5 text-xs" style="color: var(--cg-text);">
                <%= a.actor %>
                <% if a.shard&.name.present? %>
                  • <span class="font-mono" style="color: var(--cg-text-bright);"><%= a.shard.name %></span>
                <% end %>
              </div>
              <div class="mt-1 text-xs" style="color: var(--cg-muted);"><%= a.justification %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

<% end %>
