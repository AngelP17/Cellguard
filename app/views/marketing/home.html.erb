<%= render Ui::ShellComponent.new(
  title: "CellGuard",
  subtitle: "Deploy decisions backed by live reliability evidence",
  eyebrow: "CELLGUARD COMMAND CENTER",
  variant: :landing
) do %>

  <% gate_open = @budget.release_gate_open %>
  <% gate_code = gate_open ? "200 OK" : "423 LOCKED" %>
  <% open_incidents = @incidents.count { |i| i.status.to_s.downcase != "resolved" } %>
  <% active_agents = @agent_status.count { |agent| agent[:enabled] } %>

  <section class="cg-exec-hero <%= gate_open ? 'is-open' : 'is-locked' %>" data-gsap="hero">
    <div class="cg-exec-hero__copy">
      <div class="cg-brand-lockup">
        <span class="cg-brand-lockup__mark"></span>
        CellGuard
      </div>
      <h1 class="cg-exec-hero__title" data-gsap="hero-title">Govern releases with live proof.</h1>
      <p class="cg-exec-hero__lead" data-gsap="hero-subtitle">
        CellGuard turns SLOs, xyOps fabric signals, autonomous agents, and audit records into one release decision system.
      </p>
      <div class="cg-exec-hero__actions" data-gsap="hero-cta">
        <a href="/dashboard" class="cg-btn cg-btn--primary cg-btn--lg">Open Control</a>
        <a href="/incidents" class="cg-btn cg-btn--secondary cg-btn--lg">Review Triage</a>
        <a href="/runbooks/gameday" class="cg-btn cg-btn--ghost cg-btn--lg">Game Day Runbook</a>
      </div>
    </div>

    <div class="cg-exec-hero__proof" data-gsap="bento-gate">
      <div class="cg-gate-orb <%= gate_open ? 'is-open' : 'is-locked' %>">
        <div class="cg-gate-orb__code"><%= gate_code %></div>
        <div class="cg-gate-orb__label">Release Gate</div>
        <div class="cg-gate-orb__subline">
          <%= gate_open ? "SLO compliant. Deployments permitted." : "Deploys blocked until evidence clears." %>
        </div>
      </div>

      <div class="cg-proof-grid">
        <div class="cg-proof-tile">
          <span>Burn Rate</span>
          <strong class="<%= @budget.current_burn_rate.to_f < 1.0 ? 'is-ok' : 'is-danger' %>"><%= @budget.current_burn_rate.to_f %>x</strong>
          <small>Current velocity</small>
        </div>
        <div class="cg-proof-tile">
          <span>Budget</span>
          <strong class="<%= @budget.budget_remaining.to_f > 0.1 ? 'is-ok' : 'is-danger' %>"><%= (@budget.budget_remaining.to_f * 100).round(1) %>%</strong>
          <small>Remaining</small>
        </div>
        <div class="cg-proof-tile">
          <span>Incidents</span>
          <strong><%= open_incidents %></strong>
          <small>Open triage items</small>
        </div>
        <div class="cg-proof-tile">
          <span>Agents</span>
          <strong><%= active_agents %>/<%= @agent_status.size %></strong>
          <small>Enabled control loops</small>
        </div>
      </div>

      <div class="cg-proof-strip">
        <div>
          <span>Signal</span>
          <strong>xyOps job + alert</strong>
        </div>
        <div>
          <span>Decision</span>
          <strong><%= gate_code %></strong>
        </div>
        <div>
          <span>Action</span>
          <strong><%= gate_open ? "Monitor" : "Runbook + healing" %></strong>
        </div>
        <div>
          <span>Proof</span>
          <strong>audit_logs</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="cg-operating-system" data-gsap="evidence-section">
    <div class="cg-section-heading">
      <h2>One closed-loop reliability operating system</h2>
      <p>Built for the operator who needs control, the executive who needs proof, and the incident commander who needs next action.</p>
    </div>

    <div class="cg-system-map">
      <article class="cg-system-cell cg-system-cell--wide">
        <div class="cg-system-cell__label">Command cockpit</div>
        <h3>Gate state, SLO burn, fabric evidence, agents, and audit trail in one cockpit.</h3>
        <div class="cg-mini-command">
          <span class="<%= gate_open ? 'is-ok' : 'is-danger' %>"><%= gate_code %></span>
          <span>shard-default</span>
          <span><%= @budget.current_burn_rate.to_f %>x burn</span>
          <span><%= (@budget.budget_remaining.to_f * 100).round(1) %>% budget</span>
        </div>
      </article>

      <article class="cg-system-cell">
        <div class="cg-system-cell__label">Proof narrative</div>
        <h3>Show why the gate locked, what changed, who acted, and when it recovered.</h3>
        <p>Every screenshot has a visible story: signal, decision, action, proof.</p>
      </article>

      <article class="cg-system-cell">
        <div class="cg-system-cell__label">Incident triage</div>
        <h3>Classifier context, runbook recommendation, xyOps evidence, SLA impact.</h3>
        <p>Operators can acknowledge, escalate, resolve, or add notes without losing context.</p>
      </article>
    </div>
  </section>

  <section class="cg-live-activity" data-gsap="activity-section">
    <div class="cg-live-activity__header">
      <div>
        <div class="cg-panel-title">Recent Agent Activity</div>
        <div class="cg-panel-subtitle">Autonomous reliability loop</div>
      </div>
      <span class="cg-state-badge cg-state-badge--open">Live</span>
    </div>
    <div class="cg-activity-rail">
      <% @recent_activity.first(5).each do |activity| %>
        <div class="cg-activity-rail__item">
          <span class="cg-activity-rail__dot <%= activity[:status] == 'failed' ? 'is-danger' : 'is-ok' %>"></span>
          <div>
            <strong><%= activity[:agent].to_s.titleize %></strong>
            <span><%= activity[:action].presence || activity[:status].to_s.humanize %></span>
          </div>
          <small><%= time_ago_in_words(activity[:created_at]) %> ago</small>
        </div>
      <% end %>
    </div>
  </section>

  <div class="cg-stack-strip" data-gsap="stack-strip">
    <% ["Rails 7.1", "Hotwire", "ViewComponent", "Sidekiq", "Redis", "PostgreSQL", "ActionCable", "Go"].each do |tech| %>
      <span class="cg-stack-strip__badge"><%= tech %></span>
    <% end %>
  </div>

<% end %>
