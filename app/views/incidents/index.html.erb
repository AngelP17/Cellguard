<%= render Ui::ShellComponent.new(
  title: "Incidents",
  subtitle: "Classifier-driven incident triage workspace",
  eyebrow: "TRIAGE WORKSPACE"
) do %>

  <% featured = @incidents.first %>
  <% open_count = @incidents.count { |i| i.status.to_s.downcase != "resolved" } %>
  <% critical_count = @incidents.count { |i| (i.context&.dig("severity_assessment", "level") || i.severity_label).to_s.downcase == "critical" && i.status.to_s.downcase != "resolved" } %>

  <div class="space-y-3 cg-incident-triage" data-gsap="incidents-page" data-controller="incident-actions">
    <section class="cg-incident-command <%= critical_count.positive? ? 'is-critical' : 'is-normal' %>" data-gsap="incident-command">
      <div class="cg-incident-command__main">
        <div class="cg-incident-command__label">Incident command</div>
        <% if featured %>
          <h2><%= featured.title %></h2>
          <p>
            Classifier-driven triage for <span class="font-mono"><%= featured.shard&.name || "global" %></span>.
            Release policy, xyOps evidence, runbooks, and operator action stay in one workspace.
          </p>
          <div class="cg-incident-command__actions">
            <% ctx = featured.context || {} %>
            <% if ctx["suggested_runbooks"].present? %>
              <a href="/runbooks/<%= ctx['suggested_runbooks'].first['slug'] %>?incident_id=<%= featured.id %>" class="cg-btn cg-btn--primary">Open Runbook</a>
            <% else %>
              <a href="/runbooks/gameday?incident_id=<%= featured.id %>" class="cg-btn cg-btn--primary">Open Runbook</a>
            <% end %>
            <button type="button" class="cg-btn cg-btn--secondary" data-incident-id="<%= featured.id %>" data-action="click->incident-actions#acknowledge">Acknowledge</button>
            <button type="button" class="cg-btn cg-btn--danger" data-incident-id="<%= featured.id %>" data-action="click->incident-actions#escalate">Escalate</button>
          </div>
        <% else %>
          <h2>No incidents in the current feed</h2>
          <p>Demo data normally keeps this workspace populated for local proof and screenshots.</p>
        <% end %>
      </div>

      <div class="cg-incident-command__proof">
        <div class="cg-command-stat">
          <span>Open</span>
          <strong><%= open_count %></strong>
        </div>
        <div class="cg-command-stat">
          <span>Critical</span>
          <strong class="<%= critical_count.positive? ? 'is-danger' : 'is-ok' %>"><%= critical_count %></strong>
        </div>
        <div class="cg-command-stat">
          <span>MTTA</span>
          <strong><%= @mtta_label %></strong>
        </div>
        <div class="cg-command-stat">
          <span>MTTR</span>
          <strong><%= @mttr_label %></strong>
        </div>
      </div>
    </section>

    <%# Filter Bar %>
    <%= render Ui::IncidentFilterBarComponent.new %>

    <%# Metrics Row — horizontal %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2" data-gsap="incident-metrics">
      <div class="cg-scorecard">
        <div class="cg-scorecard__label">Open</div>
        <div class="cg-scorecard__value"><%= open_count %></div>
      </div>
      <div class="cg-scorecard">
        <div class="cg-scorecard__label">Critical</div>
        <div class="cg-scorecard__value" style="color: var(--cg-danger);">
          <%= critical_count %>
        </div>
      </div>
      <div class="cg-scorecard">
        <div class="cg-scorecard__label">MTTA (30d)</div>
        <div class="cg-scorecard__value"><%= @mtta_label %></div>
        <div class="cg-scorecard__meta">Mean time to acknowledge</div>
      </div>
      <div class="cg-scorecard">
        <div class="cg-scorecard__label">MTTR (30d)</div>
        <div class="cg-scorecard__value"><%= @mttr_label %></div>
        <div class="cg-scorecard__meta">Mean time to resolve</div>
      </div>
    </div>

    <%# Main Workspace — Two Column %>
    <div class="grid gap-3 md:grid-cols-3 cg-incident-workspace">
      <%# Left: Incident List %>
      <div class="md:col-span-2 space-y-2" data-gsap="incident-list">
        <% if featured %>
          <%= render Ui::IncidentCardComponent.new(incident: featured, featured: true) %>
        <% end %>

        <% @incidents.drop(1).each do |incident| %>
          <%= render Ui::IncidentCardComponent.new(incident: incident, featured: false) %>
        <% end %>
      </div>

      <%# Right: Sidebar %>
      <div class="space-y-3 cg-incident-command-sidebar" data-gsap="incident-sidebar">
        <% if featured %>
          <% ctx = featured.context || {} %>
          <% sev = ctx.dig("severity_assessment", "level").presence || featured.severity_label %>

          <%# Incident Details %>
          <div class="cg-incident-section">
            <div class="cg-panel-header">
              <div class="cg-panel-title">Incident Details</div>
            </div>
            <div class="p-3 space-y-2 text-xs">
              <div class="flex justify-between">
                <span style="color: var(--cg-muted-dim);">Status</span>
                <span class="font-medium" style="color: var(--cg-text);"><%= featured.status %></span>
              </div>
              <div class="flex justify-between">
                <span style="color: var(--cg-muted-dim);">Severity</span>
                <span class="font-medium <%= 'is-danger' if sev.to_s.downcase == 'critical' %>" style="color: var(--cg-text);"><%= sev %></span>
              </div>
              <div class="flex justify-between">
                <span style="color: var(--cg-muted-dim);">Team</span>
                <span style="color: var(--cg-text);"><%= featured.team_label %></span>
              </div>
              <div class="flex justify-between">
                <span style="color: var(--cg-muted-dim);">Service</span>
                <span style="color: var(--cg-text);"><%= featured.service_label %></span>
              </div>
              <div class="flex justify-between">
                <span style="color: var(--cg-muted-dim);">Shard</span>
                <span class="font-mono" style="color: var(--cg-text);"><%= featured.shard&.name || "—" %></span>
              </div>
              <div class="flex justify-between">
                <span style="color: var(--cg-muted-dim);">Created</span>
                <span class="font-mono" style="color: var(--cg-muted);"><%= featured.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %></span>
              </div>
            </div>
          </div>

          <%# xyOps Evidence (premium cross-system proof) %>
          <% if @xyops_evidence.present? %>
            <div class="cg-incident-section cg-xyops-accent">
              <div class="cg-panel-header">
                <div class="flex items-center gap-2">
                  <%= heroicon("circle-stack", classes: "w-3.5 h-3.5 opacity-70", stroke_width: 1.75) %>
                  <div class="cg-panel-title">xyOps Evidence</div>
                </div>
                <div class="text-[10px] font-mono" style="color: var(--cg-muted-dim);">fabric</div>
              </div>
              <div class="p-3 text-xs space-y-1.5" style="color: var(--cg-text);">
                <% if @xyops_evidence[:workflow] %>
                  <div class="flex justify-between items-baseline"><span class="text-[10px]" style="color: var(--cg-muted-dim);">triggering workflow</span> <span class="font-medium"><%= @xyops_evidence[:workflow] %></span></div>
                <% end %>
                <% if @xyops_evidence[:job] %>
                  <div class="flex justify-between items-baseline"><span class="text-[10px]" style="color: var(--cg-muted-dim);">failed job</span> <span class="font-mono"><%= @xyops_evidence[:job] %></span></div>
                <% end %>
                <% if @xyops_evidence[:server] %>
                  <div class="flex justify-between items-baseline"><span class="text-[10px]" style="color: var(--cg-muted-dim);">server</span> <span class="font-mono"><%= @xyops_evidence[:server] %></span></div>
                <% end %>
                <% if @xyops_evidence[:alert] %>
                  <div class="flex justify-between items-baseline"><span class="text-[10px]" style="color: var(--cg-muted-dim);">linked alert</span> <span class="truncate"><%= @xyops_evidence[:alert] %></span></div>
                <% end %>
                <% if @xyops_evidence[:snapshot] %>
                  <div class="pt-1.5 mt-1 border-t text-[10px] font-mono flex items-center gap-2" style="border-color: var(--cg-border); color: var(--cg-muted);">
                    <%= heroicon("camera", classes: "w-3 h-3", stroke_width: 2) %>
                    <span>cpu <%= @xyops_evidence[:snapshot][:cpu] || @xyops_evidence[:snapshot]["cpu"] || @xyops_evidence[:snapshot][:cpu_pct] %>% · redis <%= @xyops_evidence[:snapshot][:redis_ms] || @xyops_evidence[:snapshot]["redis_ms"] %>ms</span>
                  </div>
                <% end %>
                <div class="pt-1">
                  <% if @xyops_evidence[:remediation] %>
                    <span class="inline-flex items-center gap-1 text-emerald-400 text-[10px]">
                      <%= heroicon("check-circle", classes: "w-3 h-3") %> remediation executed via xyOps
                    </span>
                  <% else %>
                    <span class="cg-chip--runbook" style="font-size: 10px; padding: 1px 6px;">remediation workflow available</span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <%# Actions %>
          <div class="cg-incident-section">
            <div class="cg-panel-header">
              <div class="cg-panel-title">Actions</div>
            </div>
            <div class="p-3 space-y-1.5">
              <% if ctx["suggested_runbooks"].present? %>
                <a href="/runbooks/<%= ctx['suggested_runbooks'].first['slug'] %>?incident_id=<%= featured.id %>" class="cg-btn cg-btn--primary w-full">View Runbook</a>
              <% else %>
                <a href="/runbooks/gameday?incident_id=<%= featured.id %>" class="cg-btn cg-btn--primary w-full">View Runbook</a>
              <% end %>
              <button type="button" class="cg-btn cg-btn--secondary w-full" data-incident-id="<%= featured.id %>" data-action="click->incident-actions#acknowledge">Acknowledge</button>
              <button type="button" class="cg-btn cg-btn--danger w-full" data-incident-id="<%= featured.id %>" data-action="click->incident-actions#escalate">Escalate</button>
              <button type="button" class="cg-btn cg-btn--secondary w-full" data-incident-id="<%= featured.id %>" data-action="click->incident-actions#resolve">Resolve</button>
              <button type="button" class="cg-btn cg-btn--sm w-full" style="color: var(--cg-muted);" data-incident-id="<%= featured.id %>" data-action="click->incident-actions#addNote">Add Note</button>
            </div>
          </div>

          <%# SLA & Impact %>
          <div class="cg-incident-section">
            <div class="cg-panel-header">
              <div class="cg-panel-title">SLA & Impact</div>
            </div>
            <div class="p-3 space-y-2 text-xs">
              <div class="flex justify-between">
                <span style="color: var(--cg-muted-dim);">Response SLA</span>
                <span class="font-mono" style="color: var(--cg-text);"><%= ctx.dig("severity_assessment", "response_time_sla") || "—" %></span>
              </div>
              <div class="flex justify-between">
                <span style="color: var(--cg-muted-dim);">Affected Scope</span>
                <span style="color: var(--cg-text);"><%= ctx.dig("affected_scope") || "—" %></span>
              </div>
              <div class="flex justify-between">
                <span style="color: var(--cg-muted-dim);">Classifier</span>
                <span style="color: var(--cg-text);"><%= ctx.dig("classifier", "reason") || "—" %></span>
              </div>
            </div>
          </div>

          <%# Activity Timeline %>
          <div class="cg-incident-section">
            <div class="cg-panel-header">
              <div class="cg-panel-title">Activity</div>
            </div>
            <div class="p-3 space-y-2">
              <div class="flex items-start gap-2">
                <div class="w-1.5 h-1.5 rounded-full mt-1" style="background: var(--cg-info);"></div>
                <div>
                  <div class="text-xs" style="color: var(--cg-text);">Incident created by classifier</div>
                  <div class="text-xs font-mono" style="color: var(--cg-muted-dim);"><%= time_ago_in_words(featured.created_at) %> ago</div>
                </div>
              </div>
              <div class="flex items-start gap-2">
                <div class="w-1.5 h-1.5 rounded-full mt-1" style="background: var(--cg-warn);"></div>
                <div>
                  <div class="text-xs" style="color: var(--cg-text);">Gate locked (423)</div>
                  <div class="text-xs font-mono" style="color: var(--cg-muted-dim);"><%= time_ago_in_words(featured.created_at) %> ago</div>
                </div>
              </div>
              <div class="flex items-start gap-2">
                <div class="w-1.5 h-1.5 rounded-full mt-1" style="background: var(--cg-muted-dim);"></div>
                <div>
                  <div class="text-xs" style="color: var(--cg-muted);">Awaiting operator response</div>
                  <div class="text-xs font-mono" style="color: var(--cg-muted-dim);"><%= time_ago_in_words(featured.updated_at) rescue 'recent' %></div>
                </div>
              </div>
              <% if ctx["notes"].present? %>
                <% ctx["notes"].each do |note| %>
                  <div class="flex items-start gap-2">
                    <div class="w-1.5 h-1.5 rounded-full mt-1" style="background: var(--cg-ok);"></div>
                    <div>
                      <div class="text-xs" style="color: var(--cg-text);"><%= note["text"] || note[:text] %></div>
                      <div class="text-xs font-mono" style="color: var(--cg-muted-dim);"><%= note["actor"] || note[:actor] %> · <%= time_ago_in_words(note["created_at"] || note[:created_at]) %> ago</div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>

          <%# Policy Context %>
          <div class="cg-incident-section">
            <div class="cg-panel-header">
              <div class="cg-panel-title">Policy Context</div>
            </div>
            <div class="p-3 space-y-1.5 text-xs">
              <div class="flex justify-between">
                <span style="color: var(--cg-muted-dim);">Gate enforced</span>
                <span style="color: var(--cg-ok);">Yes</span>
              </div>
              <div class="flex justify-between">
                <span style="color: var(--cg-muted-dim);">Override requires</span>
                <span style="color: var(--cg-text);">Justification + Audit</span>
              </div>
              <div class="flex justify-between">
                <span style="color: var(--cg-muted-dim);">Auto-runbook</span>
                <span style="color: var(--cg-text);">Suggested</span>
              </div>
            </div>
          </div>
        <% else %>
          <div class="cg-panel p-4 text-center">
            <div class="text-sm" style="color: var(--cg-muted);">Select an incident to view details.</div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

<% end %>
