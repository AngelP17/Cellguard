<div class="<%= panel_classes %>" data-controller="gate-panel" data-gate-open="<%= @gate_open ? 'true' : 'false' %>" data-gsap="gate-panel">
  <div class="cg-gate-hero">
    <div class="<%= visual_classes %>">
      <div class="cg-gate-hero__lock-icon"><%= lock_icon %></div>
      <div class="<%= state_classes %>"><%= @gate_open ? 'OPEN' : 'LOCKED' %></div>
      <div class="cg-gate-hero__code"><%= @gate_open ? '200 OK' : '423' %></div>
      <% unless @gate_open %>
        <div class="w-3 h-3 rounded-full bg-red-500 animate-pulse mt-2"></div>
      <% end %>
    </div>

    <div class="cg-gate-hero__content">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="cg-state-badge <%= @gate_open ? 'cg-state-badge--open' : 'cg-state-badge--locked' %>"><%= @gate_open ? 'OPEN' : '423 LOCKED' %></span>
        <span class="cg-panel-subtitle" style="margin:0;">Release Gate</span>
      </div>

      <div class="cg-gate-hero__reason">
        <%= @gate_open ? 'SLO compliant. Deployments permitted.' : (@reason || 'Error budget exhausted.') %>
      </div>

      <% if @violation_started_at.present? && !@gate_open %>
        <div class="font-mono text-xs" style="color: var(--cg-muted);">
          Violation since <%= @violation_started_at %>
        </div>
      <% end %>

      <div class="cg-gate-hero__evidence">
        <div class="cg-evidence">
          <div class="cg-evidence__label">Burn Rate</div>
          <div class="cg-evidence__value <%= burn_color %>"><%= @burn_rate %>x</div>
        </div>
        <div class="cg-evidence">
          <div class="cg-evidence__label">Budget Remaining</div>
          <div class="cg-evidence__value <%= budget_color %>"><%= (@budget_remaining.to_f * 100).round(2) %>%</div>
        </div>
        <div class="cg-evidence">
          <div class="cg-evidence__label">Active Incident</div>
          <div class="cg-evidence__value <%= incident_color %>"><%= incident_text %></div>
        </div>
        <div class="cg-evidence">
          <div class="cg-evidence__label">Last Evaluation</div>
          <div class="cg-evidence__value is-muted" style="font-size: 0.82rem;"><%= eval_text %></div>
        </div>
      </div>

      <div class="flex items-start gap-4 flex-wrap mt-1">
        <div>
          <div class="text-xs font-semibold uppercase tracking-wider" style="color: var(--cg-muted-dim);">Recommended Action</div>
          <div class="text-sm mt-0.5" style="color: var(--cg-text-bright);"><%= recommended_text %></div>
        </div>
        <div class="flex items-center gap-2 ml-auto">
          <a href="/runbooks/gameday" class="cg-btn cg-btn--secondary">View Runbook</a>
          <a href="/api/audit-logs" class="cg-btn cg-btn--secondary" data-turbo="false">Audit Trail</a>
          <% unless @gate_open %>
            <button type="button" class="cg-btn cg-btn--danger" onclick="window.dispatchEvent(new CustomEvent('cellguard:show-override-modal', {detail: {shard: 'shard-default'}}))">Override</button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
