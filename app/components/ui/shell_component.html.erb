<% if landing? %>
<div class="min-h-screen cg-shell cg-shell--landing" data-controller="shell">
  <div class="cg-landing-wrap">
    <header class="cg-float-nav" data-gsap="float-nav">
      <a href="/" class="cg-float-nav__brand">
        <span class="cg-float-nav__icon">&#9671;</span>
        CellGuard
      </a>
      <div class="flex items-center gap-3">
        <span class="<%= HealthStatusService.badge_class %>" title="System health: <%= HealthStatusService.badge_label %>">
          <span class="cg-health-badge__dot"></span>
          <%= HealthStatusService.badge_label %>
        </span>
        <nav class="cg-top-nav" aria-label="Primary">
          <% nav_items.each do |item| %>
            <a href="<%= item[:href] %>" class="<%= nav_link_classes(item[:active]) %>" <% if item[:active] %>aria-current="page"<% end %>>
              <%= heroicon(item[:icon], classes: "cg-top-nav__icon") %>
              <span><%= item[:label] %></span>
            </a>
          <% end %>
        </nav>
      </div>
    </header>

    <%= content %>

    <footer class="cg-landing-footer">
      <span>CellGuard · Policy-as-code release safety</span>
      <span class="font-mono" style="color: var(--cg-muted-dim);">v<%= CellGuardVersion.label %></span>
    </footer>
  </div>
</div>
<% else %>
<div class="min-h-screen cg-shell" data-controller="shell">
  <div class="mx-auto max-w-[1400px] px-6 py-4">
    <header class="cg-shell-header">
      <div>
        <div class="cg-shell-eyebrow"><%= @eyebrow %></div>
        <h1 class="mt-1 text-2xl font-bold tracking-tight" style="color: #f8fafc;"><%= @title %></h1>
        <% if @subtitle.present? %>
          <div class="mt-0.5 text-xs text-neutral-500"><%= @subtitle %></div>
        <% end %>
      </div>

      <div class="flex items-center gap-3">
        <span class="<%= HealthStatusService.badge_class %>" title="System health: <%= HealthStatusService.badge_label %>">
          <span class="cg-health-badge__dot"></span>
          <%= HealthStatusService.badge_label %>
        </span>
        <nav class="cg-top-nav" aria-label="Primary">
          <% nav_items.each do |item| %>
            <a href="<%= item[:href] %>" class="<%= nav_link_classes(item[:active]) %>" <% if item[:active] %>aria-current="page"<% end %>>
              <%= heroicon(item[:icon], classes: "cg-top-nav__icon") %>
              <span><%= item[:label] %></span>
            </a>
          <% end %>
        </nav>
      </div>
    </header>

    <%= content %>

    <div class="cg-shell-footer">
      <span>CellGuard Mission Control · Policy-as-code · Auditability · Closed-loop reliability</span>
      <span class="font-mono" style="color: var(--cg-muted-dim);">v<%= CellGuardVersion.label %></span>
    </div>
  </div>
</div>
<% end %>
