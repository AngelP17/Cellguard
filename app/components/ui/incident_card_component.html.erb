<article id="incident-<%= @incident.id %>" class="<%= card_classes %>" data-incident-severity="<%= severity_key %>" data-incident-status="<%= @incident.status %>">
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="<%= severity_badge %>"><%= @severity %></span>
        <div class="text-sm font-semibold truncate"><%= @incident.title %></div>
      </div>
      <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0 text-xs" style="color: var(--cg-muted);">
        <span><%= @incident.status %></span>
        <span>·</span>
        <span><%= @incident.team_label %></span>
        <span>·</span>
        <span><%= @incident.service_label %></span>
        <% if @incident.shard&.name.present? %>
          <span>·</span>
          <span class="font-mono"><%= @incident.shard.name %></span>
        <% end %>
      </div>
    </div>
    <div class="text-xs font-mono whitespace-nowrap" style="color: var(--cg-muted-dim);">
      <%= @incident.created_at.utc.strftime("%H:%M") %>
    </div>
  </div>

  <% if @featured %>
    <div class="mt-2 pt-2 border-t" style="border-color: var(--cg-border);">
      <div class="grid gap-2 md:grid-cols-2">
        <div class="cg-evidence" style="padding: 0.5rem 0.6rem;">
          <div class="cg-evidence__label">Classifier</div>
          <div class="text-xs mt-0.5" style="color: var(--cg-text);"><%= @classifier["reason"].presence || "—" %></div>
        </div>
        <div class="cg-evidence" style="padding: 0.5rem 0.6rem;">
          <div class="cg-evidence__label">Likely Cause</div>
          <div class="text-xs mt-0.5" style="color: var(--cg-text);"><%= @likely_cause.presence || "—" %></div>
        </div>
      </div>

      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs" style="color: var(--cg-muted);">
        <% if @response_sla.present? %>
          <span>SLA: <span class="font-mono" style="color: var(--cg-text);"><%= @response_sla %></span></span>
        <% end %>
        <% if @affected_scope.present? %>
          <span>Scope: <span style="color: var(--cg-text);"><%= @affected_scope %></span></span>
        <% end %>
      </div>

      <div class="mt-2 text-xs" style="color: var(--cg-text);">
        <span style="color: var(--cg-muted-dim);">Action:</span> <%= recommended_action %>
      </div>

      <% if @suggested_runbooks.any? %>
        <div class="mt-2 flex flex-wrap gap-1">
          <% @suggested_runbooks.first(3).each do |runbook| %>
            <% slug = runbook["slug"].to_s %>
            <% title = runbook["title"].presence || slug.humanize %>
            <a href="/runbooks/<%= slug %>?incident_id=<%= @incident.id %>" class="cg-chip--runbook" style="font-size: 0.62rem; padding: 0.1rem 0.35rem;">
              <%= title %>
            </a>
          <% end %>
        </div>
      <% end %>

      <% if @context.present? %>
        <details class="mt-2">
          <summary class="text-xs cursor-pointer list-none flex items-center gap-1 hover:text-neutral-300 transition-colors" style="color: var(--cg-muted);">
            <span>Raw context</span>
            <span style="color: var(--cg-muted-dim);">▼</span>
          </summary>
          <pre class="mt-2 overflow-auto rounded bg-neutral-950/60 p-2 text-xs font-mono border" style="border-color: var(--cg-border); color: var(--cg-muted);"><%= JSON.pretty_generate(@context) rescue @context.to_json %></pre>
        </details>
      <% end %>
    </div>
  <% end %>
</article>
