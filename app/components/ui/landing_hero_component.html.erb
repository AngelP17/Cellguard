<section class="cg-hero" data-gsap="hero">
  <div class="cg-hero__title" data-gsap="hero-title"><%= @title %></div>
  <div class="cg-hero__headline" data-gsap="hero-headline"><%= @headline %></div>
  <div class="cg-hero__subtitle" data-gsap="hero-subtitle"><%= @subtitle %></div>
  <div class="cg-hero__copy" data-gsap="hero-copy"><%= @supporting_copy %></div>

  <div class="mt-6 flex flex-wrap gap-3" data-gsap="hero-buttons">
    <a href="/dashboard#game-day" class="cg-btn cg-btn--primary">
      Run Game Day
    </a>
    <a href="/dashboard" class="cg-btn cg-btn--secondary">
      Open Dashboard
    </a>
  </div>
</section>
