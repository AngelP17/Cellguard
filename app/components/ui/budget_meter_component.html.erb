<div class="cg-meter">
  <div class="flex items-center justify-between text-xs" style="color: var(--cg-muted);">
    <div>Error budget</div>
    <div class="font-mono"><%= pct %>% remaining</div>
  </div>
  <div class="mt-1.5 cg-meter__track">
    <div
      class="cg-meter__fill <%= 'is-ok' if pct > 10 %><%= ' is-warn' if pct <= 10 && pct > 0 %><%= ' is-danger' if pct <= 0 %>"
      style="width:<%= pct %>%"
      data-budget-fill
    ></div>
  </div>
  <div class="mt-1.5 text-xs" style="color: var(--cg-muted-dim);">Gate locks when remaining reaches 0.</div>
</div>
