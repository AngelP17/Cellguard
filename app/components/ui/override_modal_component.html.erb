<div class="hidden fixed inset-0 z-[100] flex items-center justify-center" data-controller="override-modal" data-override-modal-target="modal" style="display: none;">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" data-action="click->override-modal#hideModal"></div>

  <div class="relative w-full max-w-md mx-4 rounded-xl border border-neutral-700 bg-neutral-950 shadow-2xl">
    <div class="flex items-center justify-between px-5 py-4 border-b border-neutral-800">
      <div>
        <h3 class="text-sm font-semibold" style="color: var(--cg-text-bright);">Request Gate Override</h3>
        <p class="text-xs mt-0.5" style="color: var(--cg-muted);">Requires justification and audit logging</p>
      </div>
      <button type="button" class="text-neutral-500 hover:text-neutral-300 transition-colors" data-action="click->override-modal#hideModal">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form class="px-5 py-4 space-y-4" data-action="submit->override-modal#submit">
      <input type="hidden" data-override-modal-target="shard" value="shard-default">

      <div>
        <label class="block text-xs font-medium uppercase tracking-wider mb-1.5" style="color: var(--cg-muted-dim);">Actor</label>
        <input type="text"
               data-override-modal-target="actor"
               placeholder="e.g. operator-jane"
               class="w-full px-3 py-2 rounded-lg border border-neutral-800 bg-neutral-950 text-sm outline-none focus:border-emerald-500/50 transition-colors"
               style="color: var(--cg-text);"
               required>
      </div>

      <div>
        <label class="block text-xs font-medium uppercase tracking-wider mb-1.5" style="color: var(--cg-muted-dim);">Justification</label>
        <textarea data-override-modal-target="justification"
                  rows="3"
                  placeholder="Explain why this override is necessary..."
                  class="w-full px-3 py-2 rounded-lg border border-neutral-800 bg-neutral-950 text-sm outline-none focus:border-emerald-500/50 transition-colors resize-none"
                  style="color: var(--cg-text);"
                  required></textarea>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <button type="button" class="cg-btn cg-btn--secondary flex-1" data-action="click->override-modal#hideModal">Cancel</button>
        <button type="submit" class="cg-btn cg-btn--danger flex-1">Record Override</button>
      </div>
    </form>
  </div>
</div>
